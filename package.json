{
  "name": "zwemstad",
  "version": "0.2.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "sync": "node scripts/sync.mjs",
    "health": "node scripts/check-health.mjs",
    "build:web": "expo export --platform web --output-dir dist && node scripts/build-pwa.mjs && node scripts/verify-pwa.mjs",
    "build": "npm run check && npm test && npm run build:web"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.26",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "typescript": "~5.9.2",
    "@types/react": "~19.2.0",
    "cheerio": "^1.1.2"
  },
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=26.0.0"
  }
}
